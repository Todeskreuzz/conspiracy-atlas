# Copy to .dev.vars for `npm run dev:full` (wrangler pages dev). .dev.vars is git-ignored.
# Never commit real secrets.

ENVIRONMENT=development

# Cloudflare's official always-pass TEST keys (they do not protect anything; local use only).
FEATURE_TURNSTILE=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Generate the hash locally:  npm run hash-password
ADMIN_USERNAME=editor
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g.:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
