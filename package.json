{
  "name": "conspiracy-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "The Conspiracy Atlas \u2013 An Interactive Global Archive of Theories, Mysteries & Connections",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev --port 8788",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply conspiracy-atlas-db --local",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "backup:local": "node scripts/backup.mjs --local",
    "backup:remote": "node scripts/backup.mjs --remote",
    "restore:local": "node scripts/restore.mjs --local",
    "restore:remote": "node scripts/restore.mjs --remote",
    "cost-check": "node scripts/cost-check.mjs",
    "perf:wall": "vitest run tests/perf",
    "check-sources": "node scripts/check-sources.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply conspiracy-atlas-db --remote"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "cytoscape": "^3.34.4",
    "hono": "^4.13.14",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
